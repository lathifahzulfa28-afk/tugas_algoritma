# Program Ujian Matematika

nama = input("Masukkan nama mahasiswa: ")

# Menentukan target nilai
if nama.lower() == "andi":
    target = 70
elif nama.lower() == "budi":
    target = 75
elif nama.lower() == "citra":
    target = 80
else:
    print("Nama mahasiswa tidak terdaftar!")
    target = 0

if target != 0:
    print("Nama:", nama)
    print("Target nilai:", target)

    percobaan = 1
    lulus = False

    while percobaan <= 3:
        nilai = int(input("Masukkan nilai ujian ke-" + str(percobaan) + ": "))

        if nilai >= target:
            lulus = True
            break
        else:
            print("Nilai belum mencapai target.")
            percobaan += 1

    if lulus:
        print(nama, "berhasil lulus!")
    else:
        print(nama, "tidak lulus setelah 3 kali percobaan.")